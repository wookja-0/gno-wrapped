# Copy to .env and adjust. docker compose reads .env automatically; every value has a default,
# so .env is optional.

# tx-indexer for gnoland-1 (any public one works; the batch only uses upstream schema fields)
INDEXER_URL=https://indexer.gno.land/graphql/query
# GraphQL WebSocket endpoint; empty = INDEXER_URL with https -> wss
INDEXER_WS_URL=

# Range queries during catch-up: blocks per query and minimum gap between queries
CHUNK_BLOCKS=10000
REQUEST_DELAY=3s

# Public origin for share links and preview cards (baked into the web build)
SHARE_BASE_URL=http://localhost:3000

# 1 = serve the design fixtures (?fixture=whale) in the web-dev service
WRAPPED_FIXTURES=0
